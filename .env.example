# StudyPilot 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
STUDYPILOT_APP_NAME=StudyPilot
STUDYPILOT_ENVIRONMENT=development
STUDYPILOT_ENABLE_DOCS=true

# ── API ───────────────────────────────────────────────────────────────────────
STUDYPILOT_API_PREFIX=/api/v1

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── Redis ─────────────────────────────────────────────────────────────────────
STUDYPILOT_DATABASE_URL=postgresql+asyncpg://studypilot:studypilot@localhost:5432/studypilot
STUDYPILOT_REDIS_URL=redis://localhost:6379/0
POSTGRES_DB=studypilot
POSTGRES_USER=studypilot
POSTGRES_PASSWORD=change_this_in_production
REDIS_PASSWORD=change_this_in_production

# ── ChromaDB ──────────────────────────────────────────────────────────────────
STUDYPILOT_CHROMA_HOST=localhost
STUDYPILOT_CHROMA_PORT=8001
STUDYPILOT_CHROMA_COLLECTION=course_materials_v1
STUDYPILOT_UPLOAD_DIR=./data/uploads
STUDYPILOT_MAX_UPLOAD_MB=30
STUDYPILOT_WORKER_POLL_SECONDS=2

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
STUDYPILOT_SKILLS_DIR=./skills

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
